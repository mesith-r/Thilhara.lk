    <script>
document.addEventListener("DOMContentLoaded", function () {
    // Get all "read more" buttons
    var readMoreButtons = document.querySelectorAll(".read-more");

    // Add click event listeners to each button
    readMoreButtons.forEach(function (button) {
        button.addEventListener("click", function (event) {
            event.preventDefault();

            // Find the parent post content element
            var postContent = this.closest(".post-content");

            // Toggle the visibility of the limited and full comments
            var limitedComment = postContent.querySelector(".limited-comment");
            var fullComment = postContent.querySelector(".full-comment");

            if (limitedComment.classList.contains("d-none")) {
                // If the limited comment is currently hidden, show it and hide the full comment
                limitedComment.classList.remove("d-none");
                fullComment.classList.add("d-none");
                this.textContent = "read more";
            } else {
                // If the limited comment is currently shown, hide it and show the full comment
                limitedComment.classList.add("d-none");
                fullComment.classList.remove("d-none");
                this.textContent = "read less";
            }
        });
    });
});
</script>




